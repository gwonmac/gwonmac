{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "build",
    "rootDir": "app",
    // Every input this program reads crosses a boundary it does not control —
    // IPC, the settings file, ArenaNet's manifests — where absence is normal.
    "strict": true,
    // A renamed base member otherwise turns an override into a second method
    // that nothing calls and nothing reports.
    "noImplicitOverride": true,
    // Chunk tables, manifest rows and argv are indexed by values from outside
    // the program, so a miss is a normal case rather than a defect.
    "noUncheckedIndexedAccess": true,
    // An absent field and an explicit undefined are the same value after a JSON
    // round trip and different values to every contract in app/shared.
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["app"],
  // app/renderer is tsconfig.renderer.json's program, not this one: it checks
  // for Chromium with the DOM libs while Rollup emits build/renderer. The overlap
  // was invisible while the renderer was JavaScript, because this project sets
  // no `allowJs` and so could not read it; the first renderer `.ts` made it a
  // second compilation of the same files under a lib that has no `Document`.
  // app/preload is bundled by Rollup into build/preload and checked by
  // tsconfig.tests.json; emitting it here would only leave unused copies.
  // A feature's companion part, its renderer/ folder and the parts registry are
  // renderer code that only app/renderer imports, so the renderer program checks them.
  // A feature's hub-views/ folder is a Hub page the Vue kit draws; the Tools program checks it.
  "exclude": ["node_modules", "out", "app/renderer", "app/ui", "app/preload",
    "app/features/*/companion.ts", "app/features/companion-parts.ts", "app/features/*/renderer/**", "app/features/*/hub-views/**", "app/shared/ui/resize.ts", "app/shared/ui/frame.ts", "app/shared/ui/elite-map-pointer.ts", "app/shared/ui/elite-marker-paint.ts", "app/shared/ui/hub-view.ts", "app/shared/ui/focusable.ts"]
}
